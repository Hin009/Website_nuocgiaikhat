POSTGRES_DB=beverage_store
DB_PORT=15432
DB_URL=jdbc:postgresql://localhost:15432/beverage_store
DB_USERNAME=drink_user
DB_PASSWORD=change_me_local
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
SERVER_PORT=8080
# Receiving bank for checkout QR. BANK_ID is the VietQR bank code or BIN.
BANK_TRANSFER_BANK_ID=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_NAME=
# Only set for the FIRST run; remove after creating the admin.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Gmail sender: enable 2-Step Verification and create an App Password.
# Put the real values only in .env (ignored by Git), never in this example.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_AUTH=true
MAIL_STARTTLS=true
